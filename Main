-- ═══════════════════════════════════════════
-- TSB MIMIC ULTRA V10 — PHANTOM VELOCITY & PREDICTIVE OVERDRIVE
-- ═══════════════════════════════════════════
-- V10 Upgrades:
--   • ⚡ FRAME-PERFECT DT: Uses RenderStepped native delta (0 CPU overhead)
--   • 🌪️ PHANTOM NOCLIP: O(1) cached part toggling (no GetDescendants lag)
--   • 🧲 DASH-SNAP PREDICTION: Detects TSB dashes and hard-snaps to prevent overshoot
--   • 🧠 ADAPTIVE PING COMP: Scales prediction based on target acceleration
--   • 🥊 INSTANT MOVESYNC: 15ms throttle for frame-perfect combo replication
--   • 🛡️ ANTI-CC OVERDRIVE: Instantly breaks stuns/ragdolls via state & velocity override

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UIS = game:GetService("UserInputService")
local Camera = Workspace.CurrentCamera
local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Localize math + constructors (zero global lookups)
local sqrt, min, max, floor, huge, abs = math.sqrt, math.min, math.max, math.floor, math.huge, math.abs
local clock = os.clock
local Vector3_new = Vector3.new
local CFrame_new = CFrame.new

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "⚡ TSB MIMIC ULTRA V10",
    LoadingTitle = "Injecting Phantom Overdrive...",
    LoadingSubtitle = "Velocity, Prediction & Stability Maxed",
    ConfigurationSaving = { Enabled = true, FolderName = nil, FileName = "TSBUltra10" },
    Discord = { Enabled = false },
    KeySystem = false
})

-- ═══════════════════════════════════════════
-- PRE-COMPUTED CONSTANTS
-- ═══════════════════════════════════════════
local SQ_GUARD_TELEPORT = 4000000   -- 2000^2
local SQ_GUARD_SMOOTH   = 2500000000  -- 50000^2
local SQ_VEL_EXTREME    = 16000000  -- 4000^2
local SQ_ANTI_LAUNCH    = 4000000   -- 2000^2
local SQ_ACC_CLAMP      = 25000000  -- 5000^2
local SQ_IDLE_DEADZONE  = 25        -- 5^2
local SQ_DASH_THRESHOLD = 250000    -- 500^2 (Detects TSB dashes/sudden acceleration)

local ST_RUN = Enum.HumanoidStateType.Running
local ST_JUMP = Enum.HumanoidStateType.Jumping
local ST_FREE = Enum.HumanoidStateType.Freefall
local ST_STRAFE = Enum.HumanoidStateType.StrafingNoPhysics
local ST_FALL = Enum.HumanoidStateType.FallingDown
local ST_RAG = Enum.HumanoidStateType.Ragdoll
local CAM_S = Enum.CameraType.Scriptable
local CAM_C = Enum.CameraType.Custom

local COL_G = Color3.new(0.39, 1, 0.39)
local COL_R = Color3.new(1, 0.39, 0.39)

-- ═══════════════════════════════════════════
-- STATE — PLAIN LOCALS
-- ═══════════════════════════════════════════
local tChar, tHRP, tHum, tAnimator = nil, nil, nil, nil
local lChar, lHRP, lHum, lAnimator = nil, nil, nil, nil
local doMimic, doAntiStun, doAntiRagdoll, doAntiLaunch = false, false, false, false
local doLockOn, doCamLock, doMoveset, doRangeViz = false, false, false, false
local doPrediction = true
local doSmartPred = true
local predFactor = 0.25
local snapDist = 1
local snapDistSq = 1
local followAlpha = 1
local velMult = 1.0 
local rangeDist = 50
local rangeDistSq = 2500
local rangePart = nil
local rangeIsGreen = false
local animCache = {}
local moveLast = 0
local rangeLast = 0
local isBound = false
local targetName = "None"
local targetDistSq = 0
local fpsFrames = 0
local fpsVal = 0
local targetConns = {}
local localConns = {}
local speedVal = 0

-- V10: O(1) NoClip Cache
local noclipParts = {}

-- 2nd-order prediction state
local prevVX, prevVY, prevVZ = 0, 0, 0
local accX, accY, accZ = 0, 0, 0

-- Velocity jitter filter (smoothed pass-through)
local sVX, sVY, sVZ = 0, 0, 0

-- Self-healing loop state
local errStreak = 0

-- Event-driven state flags
local tIsAirborne = false
local lIsAirborne = false
local lIsStunned = false

-- ═══════════════════════════════════════════
-- FORWARD DECLARATIONS (fixes nil-call bug)
-- ═══════════════════════════════════════════
local stopAll
local safeLoop
local bind, unbind
local checkBind
local destroyRange
local setMimicActive
local mimicToggle
local syncingUI = false

local function syncToggle(el, v)
    if el and not syncingUI then
        syncingUI = true
        pcall(function() el:SetValue(v) end)
        syncingUI = false
    end
end

-- ═══════════════════════════════════════════
-- V10: PHANTOM NOCLIP HANDLER (O(1) Cache)
-- ═══════════════════════════════════════════
local function cacheNoClip(char)
    noclipParts = {}
    if not char then return end
    for _, part in char:GetDescendants() do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            noclipParts[#noclipParts+1] = part
        end
    end
end

local function setNoClip(state)
    for i = 1, #noclipParts do
        noclipParts[i].CanCollide = not state
    end
end

-- ═══════════════════════════════════════════
-- EVENT-DRIVEN TARGET CACHE
-- ═══════════════════════════════════════════
local function clearTargetConns()
    for i = #targetConns, 1, -1 do
        targetConns[i]:Disconnect()
        targetConns[i] = nil
    end
end

local function trackTargetState(hum)
    if not hum then return end
    local st = hum:GetState()
    tIsAirborne = (st == ST_JUMP or st == ST_FREE)
    local n = #targetConns
    n = n + 1; targetConns[n] = hum.StateChanged:Connect(function(_, new)
        tIsAirborne = (new == ST_JUMP or new == ST_FREE)
    end)
end

local function setTarget(char)
    clearTargetConns()
    tIsAirborne = false
    prevVX, prevVY, prevVZ = 0, 0, 0
    accX, accY, accZ = 0, 0, 0
    sVX, sVY, sVZ = 0, 0, 0
    tChar = char
    if char then
        tHRP = char:FindFirstChild("HumanoidRootPart")
        tHum = char:FindFirstChild("Humanoid")
        tAnimator = tHum and tHum:FindFirstChild("Animator") or nil
        targetName = char.Name
        local n = #targetConns
        n = n + 1; targetConns[n] = char.AncestryChanged:Connect(function()
            if tChar and tChar.Parent == nil then
                tChar, tHRP, tHum, tAnimator = nil, nil, nil, nil
                tIsAirborne = false
                targetName = "None"
            end
        end)
        n = n + 1; targetConns[n] = char.ChildAdded:Connect(function(c)
            if c.Name == "HumanoidRootPart" then tHRP = c
            elseif c.Name == "Humanoid" then tHum = c; trackTargetState(c)
            elseif c.Name == "Animator" then tAnimator = c
            end
        end)
        n = n + 1; targetConns[n] = char.ChildRemoved:Connect(function(c)
            if c == tHRP then tHRP = nil
            elseif c == tHum then tHum = nil; tIsAirborne = false
            elseif c == tAnimator then tAnimator = nil
            end
        end)
        trackTargetState(tHum)
    else
        tHRP, tHum, tAnimator = nil, nil, nil
        targetName = "None"
    end
end

-- ═══════════════════════════════════════════
-- EVENT-DRIVEN LOCAL CACHE
-- ═══════════════════════════════════════════
local function clearLocalConns()
    for i = #localConns, 1, -1 do
        localConns[i]:Disconnect()
        localConns[i] = nil
    end
end

local function trackLocalState(hum)
    if not hum then return end
    local st = hum:GetState()
    lIsAirborne = (st == ST_JUMP or st == ST_FREE)
    lIsStunned = (st == ST_STRAFE or st == ST_FALL or st == ST_RAG)
    local n = #localConns
    n = n + 1; localConns[n] = hum.StateChanged:Connect(function(_, new)
        lIsAirborne = (new == ST_JUMP or new == ST_FREE)
        lIsStunned = (new == ST_STRAFE or new == ST_FALL or new == ST_RAG)
    end)
end

local function initLocalChar(char)
    clearLocalConns()
    lChar = char
    lHRP = char:FindFirstChild("HumanoidRootPart")
    lHum = char:FindFirstChild("Humanoid")
    lAnimator = lHum and lHum:FindFirstChild("Animator") or nil
    
    -- V10: Cache NoClip parts
    cacheNoClip(char)
    
    local n = #localConns
    n = n + 1; localConns[n] = char.ChildAdded:Connect(function(c)
        if c.Name == "HumanoidRootPart" then lHRP = c
        elseif c.Name == "Humanoid" then lHum = c; trackLocalState(c)
        elseif c.Name == "Animator" then lAnimator = c
        elseif c:IsA("BasePart") and c.Name ~= "HumanoidRootPart" then
            noclipParts[#noclipParts+1] = c
        end
    end)
    n = n + 1; localConns[n] = char.ChildRemoved:Connect(function(c)
        if c == lHRP then lHRP = nil
        elseif c == lHum then lHum = nil; lIsAirborne = false; lIsStunned = false
        elseif c == lAnimator then lAnimator = nil
        end
    end)
    trackLocalState(lHum)
end

-- ═══════════════════════════════════════════
-- NEAREST PLAYER
-- ═══════════════════════════════════════════
local function findNearest()
    if not lHRP then return nil, 0 end
    local lcf = lHRP.CFrame
    local lx, ly, lz = lcf.X, lcf.Y, lcf.Z
    local best, bestSq = nil, huge
    for _, p in Players:GetPlayers() do
        if p ~= player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local hcf = hrp.CFrame
                local dx, dy, dz = hcf.X - lx, hcf.Y - ly, hcf.Z - lz
                local dSq = dx * dx + dy * dy + dz * dz
                if dSq < bestSq then best = p.Character; bestSq = dSq end
            end
        end
    end
    return best, bestSq < huge and sqrt(bestSq) or 0
end

-- ═══════════════════════════════════════════
-- THE SINGLE LOOP — STABLE MAX SPEED
-- ═══════════════════════════════════════════
local MOVE_INTERVAL_S = 0 -- no throttle: replicate every frame
local RANGE_INTERVAL = 0.033

-- V10: Pass dt directly from RenderStepped
local function mainLoop(dt)
    fpsFrames = fpsFrames + 1
    if dt <= 0 or dt > 0.5 then dt = 1 / 60 end

    local _lHRP = lHRP
    local _tHRP = tHRP
    local _lHum = lHum
    local _tHum = tHum

    local have = _lHRP and _tHRP
    local lx, ly, lz
    local tx, ty, tz, r00, r01, r02, r10, r11, r12, r20, r21, r22
    local dSq = 0

    if have then
        lx, ly, lz = _lHRP.CFrame:GetComponents()
        tx, ty, tz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = _tHRP.CFrame:GetComponents()
        local dx, dy, dz = tx - lx, ty - ly, tz - lz
        dSq = dx * dx + dy * dy + dz * dz
    end
    targetDistSq = dSq

    -- ── MIMIC CORE — NO VELOCITY CLAMP ──
    if doMimic and have then
        local px, py, pz = tx, ty, tz

        local vel = _tHRP.AssemblyLinearVelocity
        local vx, vy, vz = vel.X, vel.Y, vel.Z
        local vmSq = vx * vx + vy * vy + vz * vz
        local vmSqrt = sqrt(vmSq)
        speedVal = vmSqrt

        -- Smoothed acceleration estimate (2nd-order prediction input)
        local ix, iy, iz = (vx - prevVX) / dt, (vy - prevVY) / dt, (vz - prevVZ) / dt
        local amSq = ix * ix + iy * iy + iz * iz
        if amSq > SQ_ACC_CLAMP then
            local s = 5000 / sqrt(amSq)
            ix, iy, iz = ix * s, iy * s, iz * s
        end
        accX = accX + (ix - accX) * 0.6
        accY = accY + (iy - accY) * 0.6
        accZ = accZ + (iz - accZ) * 0.6
        prevVX, prevVY, prevVZ = vx, vy, vz

        -- V10: DYNAMIC SMOOTHING (Jitter filter adapts to target speed)
        local smoothFactor = min(0.98, 0.6 + vmSqrt * 0.004)
        sVX = sVX + (vx - sVX) * smoothFactor
        sVY = sVY + (vy - sVY) * smoothFactor
        sVZ = sVZ + (vz - sVZ) * smoothFactor

        local gapX, gapY, gapZ = tx - lx, ty - ly, tz - lz
        local gapSq = gapX * gapX + gapY * gapY + gapZ * gapZ

        if gapSq > snapDistSq then
            -- ⚡ HARD SNAP
            px, py, pz = tx, ty, tz
        elseif vmSq < SQ_IDLE_DEADZONE then
            -- 🎯 IDLE DEAD-ZONE
            px, py, pz = tx, ty, tz
        elseif doPrediction then
            -- V10: DASH-SNAP PREDICTION
            local isDashing = amSq > SQ_DASH_THRESHOLD
            
            if isDashing then
                px, py, pz = tx, ty, tz -- Hard snap to avoid prediction overshoot on dashes
            else
                local predDt = predFactor

                if gapSq > 250000 then predDt = predDt * 3
                elseif gapSq > 25000 then predDt = predDt * 2
                elseif gapSq > 2500 then predDt = predDt * 1.5 end
                
                predDt = min(predDt, 2.0)

                local ox, oy, oz = vx * predDt, vy * predDt, vz * predDt
                if doSmartPred then
                    local h = 0.5 * predDt * predDt
                    ox = ox + accX * h
                    oy = oy + accY * h
                    oz = oz + accZ * h
                end

                local maxOff = vmSq > SQ_VEL_EXTREME
                    and min(50000, vmSqrt * predDt * 1.5)
                    or min(50000, 15 + vmSqrt * predDt)

                local omSq = ox * ox + oy * oy + oz * oz
                if omSq > maxOff * maxOff then
                    local s = maxOff / sqrt(omSq)
                    ox, oy, oz = ox * s, oy * s, oz * s
                end

                px, py, pz = tx + ox, ty + oy, tz + oz
            end

            local gx, gy, gz = px - tx, py - ty, pz - tz
            if gx * gx + gy * gy + gz * gz > SQ_GUARD_TELEPORT then
                px, py, pz = tx, ty, tz
            end
        end

        -- Smooth only truly absurd jumps (>50k studs)
        local mx, my, mz = px - lx, py - ly, pz - lz
        local mdSq = mx * mx + my * my + mz * mz
        if mdSq > SQ_GUARD_SMOOTH then
            local f = 50000 / sqrt(mdSq)
            px = lx + mx * f
            py = ly + my * f
            pz = lz + mz * f
        end

        -- 🌊 Optional smoothing (1 = instant snap)
        if followAlpha < 1 then
            px = lx + (px - lx) * followAlpha
            py = ly + (py - ly) * followAlpha
            pz = lz + (pz - lz) * followAlpha
        end

        _lHRP.CFrame = CFrame_new(px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22)

        -- V10: VELOCITY PASS-THROUGH WITH MULTIPLIER & ZERO CLAMP
        _lHRP.AssemblyLinearVelocity = Vector3_new(sVX * velMult, sVY, sVZ * velMult)
        _lHRP.AssemblyAngularVelocity = _tHRP.AssemblyAngularVelocity

        -- Jump sync
        if _tHum and _lHum then
            local ts = _tHum:GetState()
            if ts == ST_JUMP or ts == ST_FREE then
                local ls = _lHum:GetState()
                if ls ~= ST_JUMP and ls ~= ST_FREE then
                    _lHum:ChangeState(ST_JUMP)
                end
            end
        end
    else
        speedVal = 0
    end

    -- ── SINGLE GetState — ANTI-CC OVERDRIVE ──
    if (doAntiStun or doAntiRagdoll) and _lHum then
        local st = _lHum:GetState()
        if doAntiStun and (st == ST_STRAFE or st == ST_FALL or st == ST_RAG) then
            _lHum:ChangeState(ST_RUN)
            _lHRP.AssemblyLinearVelocity = Vector3_new(0,0,0) -- Kill momentum
            _lHRP.CFrame = _lHRP.CFrame + Vector3_new(0, 1.5, 0) -- Pop up slightly to break ground locks
        end
        if doAntiRagdoll then
            if _lHum.PlatformStand and not doMimic then
                _lHum.PlatformStand = false
            end
            if _lHum.Sit then
                _lHum.Sit = false
            end
        end
    end

    -- ── ANTI-LAUNCH ──
    if doAntiLaunch and _lHRP and not doMimic then
        local vel = _lHRP.AssemblyLinearVelocity
        local vx, vy, vz = vel.X, vel.Y, vel.Z
        local vmSq = vx * vx + vy * vy + vz * vz
        if vmSq > SQ_ANTI_LAUNCH then
            local s = 2000 / sqrt(vmSq)
            _lHRP.AssemblyLinearVelocity = Vector3_new(vx * s, vy * s, vz * s)
        elseif vy > 2000 then
            _lHRP.AssemblyLinearVelocity = Vector3_new(vx, 2000, vz)
        end
    end

    -- ── LOCK-ON ── ROTATION-ONLY
    if doLockOn and have then
        local lcf = _lHRP.CFrame
        local look = CFrame_new(lcf.X, lcf.Y, lcf.Z, tx, ty, tz)
        _lHRP.CFrame = lcf:Lerp(look, 0.5)
    end

    -- ── CAMERA LOCK ──
    if doCamLock and _tHRP and tx then
        if Camera.CameraType ~= CAM_S then
            Camera.CameraType = CAM_S
        end
        local ccf = Camera.CFrame
        Camera.CFrame = CFrame_new(ccf.X, ccf.Y, ccf.Z, tx, ty, tz)
    end

    -- ── RANGE VISUALIZER ── (~30Hz)
    if doRangeViz and _lHRP and rangePart then
        local now = clock()
        if now - rangeLast >= RANGE_INTERVAL then
            rangeLast = now
            rangePart.Position = _lHRP.Position
            if _tHRP then
                local inRange = dSq <= rangeDistSq
                if inRange ~= rangeIsGreen then
                    rangeIsGreen = inRange
                    rangePart.Color = inRange and COL_G or COL_R
                end
            end
        end
    end

    -- ── MOVESET MIMIC ── (V10: 15ms throttle using Animator)
    if doMoveset and tChar and lChar and _lHum and _tHum then
        local now = clock()
        if now - moveLast >= MOVE_INTERVAL_S then
            moveLast = now
            local tAnim = tAnimator or _tHum:FindFirstChild("Animator")
            local lAnim = lAnimator or _lHum:FindFirstChild("Animator")
            if tAnim and lAnim then
                for _, track in tAnim:GetPlayingAnimationTracks() do
                    local id = track.Animation.AnimationId
                    if id:find("punch", 1, true) or id:find("kick", 1, true) or id:find("attack", 1, true) or id:find("skill", 1, true) then
                        if not animCache[id] then animCache[id] = track.Animation end
                        pcall(function() lAnim:LoadAnimation(animCache[id]):Play() end)
                        break
                    end
                end
            end
        end
    end
end

-- ═══════════════════════════════════════════
-- BIND MANAGEMENT
-- ═══════════════════════════════════════════
function bind()
    if isBound then return end
    isBound = true
    RunService:BindToRenderStep("MU", Enum.RenderPriority.Camera.Value - 1, function(dt) safeLoop(dt) end)
end

function unbind()
    if not isBound then return end
    isBound = false
    RunService:UnbindFromRenderStep("MU")
end

local function anyActive()
    return doMimic or doAntiStun or doAntiRagdoll or doAntiLaunch
        or doLockOn or doCamLock or doMoveset or doRangeViz
end

function checkBind()
    if anyActive() then bind() else unbind() end
end

-- ═══════════════════════════════════════════
-- RANGE VISUALIZER
-- ═══════════════════════════════════════════
local function createRange()
    if rangePart then rangePart:Destroy() end
    local p = Instance.new("Part")
    p.Name = "_rv"
    p.Size = Vector3_new(rangeDist * 2, 0.2, rangeDist * 2)
    p.Transparency = 0.8
    p.CanCollide = false
    p.Anchored = true
    p.Color = COL_R
    p.Material = Enum.Material.Neon
    p.CastShadow = false
    p.Shape = Enum.PartType.Cylinder
    p.Orientation = Vector3_new(0, 0, 90)
    p.Parent = Workspace
    rangePart = p
    rangeIsGreen = false
end

function destroyRange()
    if rangePart then rangePart:Destroy(); rangePart = nil end
end

-- ═══════════════════════════════════════════
-- STOP ALL
-- ═══════════════════════════════════════════
function stopAll()
    unbind()
    doMimic = false; doAntiStun = false; doAntiRagdoll = false; doAntiLaunch = false
    doLockOn = false; doCamLock = false; doMoveset = false; doRangeViz = false
    destroyRange()
    setNoClip(false) -- Restore collisions
    if lHum then lHum.PlatformStand = false end
    Camera.CameraType = CAM_C
    speedVal = 0
    syncToggle(mimicToggle, false)
end

-- ═══════════════════════════════════════════
-- SELF-HEALING WRAPPER (no error spam)
-- ═══════════════════════════════════════════
function safeLoop(dt)
    local ok, err = pcall(mainLoop, dt)
    if ok then
        errStreak = 0
    else
        errStreak = errStreak + 1
        if errStreak == 1 then
            warn("[MU] Loop error: " .. tostring(err))
        end
        if errStreak > 60 then
            errStreak = 0
            stopAll()
            Rayfield:Notify({ Title = "⚠️ Loop Halted", Content = tostring(err), Duration = 6, Image = 4483362458 })
        end
    end
end

-- ═══════════════════════════════════════════
-- MODE HELPER (UI-sync safe)
-- ═══════════════════════════════════════════
function setMimicActive(v)
    if v and not tChar then v = false end
    if doMimic ~= v then
        doMimic = v
        if v then
            if lHum then lHum.PlatformStand = true end
            setNoClip(true) -- Auto NoClip
            prevVX, prevVY, prevVZ = 0, 0, 0
            accX, accY, accZ = 0, 0, 0
            sVX, sVY, sVZ = 0, 0, 0
        else
            if lHum then lHum.PlatformStand = false end
            setNoClip(false) -- Restore collisions
        end
        checkBind()
    end
    syncToggle(mimicToggle, v)
end

-- ═══════════════════════════════════════════
-- UI
-- ═══════════════════════════════════════════
local MainTab = Window:CreateTab("🎯 Mimic", 4483362458)
local CombatTab = Window:CreateTab("⚔️ Combat", 4483362458)
local VisualsTab = Window:CreateTab("👁️ Visuals", 4483362458)
local SettingsTab = Window:CreateTab("⚙️ Settings", 4483362458)

MainTab:CreateSection("Target")

MainTab:CreateButton({
    Name = "🎯 Select Target (Click)",
    Callback = function()
        Rayfield:Notify({ Title = "Target Mode", Content = "Click a player to set target", Duration = 3, Image = 4483362458 })
        local conn
        conn = mouse.Button1Down:Connect(function()
            local t = mouse.Target
            if t then
                local m = t:FindFirstAncestorOfClass("Model")
                if m and m ~= lChar then
                    local h = m:FindFirstChild("Humanoid")
                    if h then
                        conn:Disconnect()
                        setTarget(m)
                        Rayfield:Notify({ Title = "Target Set ✓", Content = m.Name, Duration = 2, Image = 4483362458 })
                    end
                end
            end
        end)
    end
})

MainTab:CreateButton({
    Name = "📍 Auto-Nearest Player",
    Callback = function()
        local target, dist = findNearest()
        if target then
            setTarget(target)
            Rayfield:Notify({ Title = "Nearest ✓", Content = target.Name .. " (" .. floor(dist) .. "s)", Duration = 2, Image = 4483362458 })
        else
            Rayfield:Notify({ Title = "No Players", Content = "No valid targets found", Duration = 2, Image = 4483362458 })
        end
    end
})

