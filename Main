-- NEURAL NETWORK MODULE (Enhanced deep feedforward network for parameter optimization)
local NeuralNetwork = {
    -- Network state
    running = false,
    samples = {},
    maxSamples = 20,
    
    -- Enhanced network architecture (4-layer deep network)
    inputSize = 4,      -- [predictionFactor, rangeDistance, lockOnActive, currentFPS]
    hiddenSize1 = 8,    -- First hidden layer (increased capacity)
    hiddenSize2 = 8,    -- Second hidden layer (depth for complex patterns)
    hiddenSize3 = 4,    -- Third hidden layer (feature condensation)
    outputSize = 3,     -- [optimalPrediction, optimalRange, optimalLockOn]
    
    -- Weights (He/Xavier initialization for deeper networks)
    weightsIH1 = {},
    weightsH1H2 = {},
    weightsH2H3 = {},
    weightsH3O = {},
    biasH1 = {},
    biasH2 = {},
    biasH3 = {},
    biasO = {},
    
    -- Training parameters
    learningRate = 0.02,
    trainingIterations = 50,  -- Increased training iterations
    batchSize = 10,
    
    -- Performance metrics
    bestScore = 0,
    currentScore = 0,
    trainingLoss = 0,
    epoch = 0,
}

-- Initialize neural network weights with He initialization
function NeuralNetwork:init()
    math.randomseed(tick())
    
    -- He initialization for better gradient flow in deep networks
    -- Input to Hidden1 weights
    local heScale1 = math.sqrt(2.0 / self.inputSize)
    for i = 1, self.inputSize do
        self.weightsIH1[i] = {}
        for j = 1, self.hiddenSize1 do
            self.weightsIH1[i][j] = (math.random() - 0.5) * 2 * heScale1
        end
    end
    
    -- Hidden1 to Hidden2 weights
    local heScale2 = math.sqrt(2.0 / self.hiddenSize1)
    for i = 1, self.hiddenSize1 do
        self.weightsH1H2[i] = {}
        for j = 1, self.hiddenSize2 do
            self.weightsH1H2[i][j] = (math.random() - 0.5) * 2 * heScale2
        end
    end
    
    -- Hidden2 to Hidden3 weights
    local heScale3 = math.sqrt(2.0 / self.hiddenSize2)
    for i = 1, self.hiddenSize2 do
        self.weightsH2H3[i] = {}
        for j = 1, self.hiddenSize3 do
            self.weightsH2H3[i][j] = (math.random() - 0.5) * 2 * heScale3
        end
    end
    
    -- Hidden3 to Output weights (Xavier for sigmoid output)
    local xavierScale = math.sqrt(1.0 / self.hiddenSize3)
    for i = 1, self.hiddenSize3 do
        self.weightsH3O[i] = {}
        for j = 1, self.outputSize do
            self.weightsH3O[i][j] = (math.random() - 0.5) * 2 * xavierScale
        end
    end
    
    -- Bias initialization (small values)
    for i = 1, self.hiddenSize1 do
        self.biasH1[i] = 0.01
    end
    for i = 1, self.hiddenSize2 do
        self.biasH2[i] = 0.01
    end
    for i = 1, self.hiddenSize3 do
        self.biasH3[i] = 0.01
    end
    for i = 1, self.outputSize do
        self.biasO[i] = 0
    end
    
    -- Generate and train on simulated data
    self:generateSimulatedData()
    self:trainNetwork()
end

-- Leaky ReLU activation function (prevents dying neurons)
function NeuralNetwork:leakyRelu(x)
    return x > 0 and x or x * 0.01
end

-- Leaky ReLU derivative for backpropagation
function NeuralNetwork:leakyReluDerivative(x)
    return x > 0 and 1 or 0.01
end

-- Tanh activation (improved over sigmoid for hidden layers)
function NeuralNetwork:tanh(x)
    local exp2x = math.exp(2 * x)
    return (exp2x - 1) / (exp2x + 1)
end

-- Tanh derivative
function NeuralNetwork:tanhDerivative(x)
    local t = self:tanh(x)
    return 1 - t * t
end

-- Sigmoid for output normalization
function NeuralNetwork:sigmoid(x)
    -- Prevent overflow
    x = math.max(-50, math.min(50, x))
    return 1 / (1 + math.exp(-x))
end

-- Sigmoid derivative
function NeuralNetwork:sigmoidDerivative(x)
    local s = self:sigmoid(x)
    return s * (1 - s)
end

-- Forward pass through deep network
function NeuralNetwork:forward(inputs)
    -- Hidden layer 1 computation (LeakyReLU)
    local hidden1 = {}
    local z1 = {}
    for j = 1, self.hiddenSize1 do
        local sum = self.biasH1[j]
        for i = 1, self.inputSize do
            sum = sum + inputs[i] * self.weightsIH1[i][j]
        end
        z1[j] = sum
        hidden1[j] = self:leakyRelu(sum)
    end
    
    -- Hidden layer 2 computation (Tanh)
    local hidden2 = {}
    local z2 = {}
    for j = 1, self.hiddenSize2 do
        local sum = self.biasH2[j]
        for i = 1, self.hiddenSize1 do
            sum = sum + hidden1[i] * self.weightsH1H2[i][j]
        end
        z2[j] = sum
        hidden2[j] = self:tanh(sum)
    end
    
    -- Hidden layer 3 computation (LeakyReLU)
    local hidden3 = {}
    local z3 = {}
    for j = 1, self.hiddenSize3 do
        local sum = self.biasH3[j]
        for i = 1, self.hiddenSize2 do
            sum = sum + hidden2[i] * self.weightsH2H3[i][j]
        end
        z3[j] = sum
        hidden3[j] = self:leakyRelu(sum)
    end
    
    -- Output layer computation (Sigmoid)
    local outputs = {}
    local zo = {}
    for k = 1, self.outputSize do
        local sum = self.biasO[k]
        for j = 1, self.hiddenSize3 do
            sum = sum + hidden3[j] * self.weightsH3O[j][k]
        end
        zo[k] = sum
        outputs[k] = self:sigmoid(sum)
    end
    
    return outputs, {z1 = z1, z2 = z2, z3 = z3, zo = zo, h1 = hidden1, h2 = hidden2, h3 = hidden3}
end

-- Calculate performance score based on current metrics
function NeuralNetwork:calculateScore()
    local score = 0
    
    -- FPS component (higher is better, target 60)
    score = score + math.min(State.currentFPS / 60, 1) * 40
    
    -- Distance to target (closer is better when in range)
    if State.targetHRP and State.localHRP then
        local distance = (State.targetHRP.Position - State.localHRP.Position).Magnitude
        if distance <= State.rangeDistance then
            score = score + 30 -- In range bonus
            score = score + (1 - math.min(distance / State.rangeDistance, 1)) * 20
        else
            score = score + math.max(0, 20 - (distance - State.rangeDistance) / 10)
        end
    end
    
    -- Lock-on accuracy (rotation alignment)
    if State.lockOn and State.targetHRP and State.localHRP then
        local direction = (State.targetHRP.Position - State.localHRP.Position).Unit
        local forward = State.localHRP.CFrame.LookVector
        local alignment = direction:Dot(forward)
        score = score + math.max(0, alignment) * 10
    end
    
    return score
end

-- Generate simulated training data for pre-training
function NeuralNetwork:generateSimulatedData()
    self.trainingData = {}
    
    -- Generate diverse training scenarios
    for i = 1, 100 do
        local predFactor = math.random() * 0.5  -- 0 to 0.5
        local range = 10 + math.random() * 90   -- 10 to 100
        local lockOn = math.random() > 0.5 and 1 or 0
        local fps = 30 + math.random() * 30     -- 30 to 60
        
        -- Normalize inputs
        local inputs = {
            predFactor / 0.5,
            range / 100,
            lockOn,
            math.min(fps / 60, 1)
        }
        
        -- Calculate optimal outputs based on heuristics
        local optimalPred, optimalRange, optimalLockOn
        
        -- High FPS allows higher prediction, but cap at 0.30 to prevent teleporting
        -- Values near 0.5 cause erratic movement and should be avoided
        if fps > 50 then
            optimalPred = 0.15 + math.random() * 0.08  -- 0.15-0.23 (safer range)
        else
            optimalPred = 0.08 + math.random() * 0.07  -- 0.08-0.15
        end
        
        -- Ensure we never train with values approaching 0.4+
        optimalPred = math.min(optimalPred, 0.30)
        
        -- Optimal range based on FPS and prediction
        if fps > 50 and predFactor > 0.15 then
            optimalRange = 60 + math.random() * 30  -- 60-90
        else
            optimalRange = 30 + math.random() * 30  -- 30-60
        end
        
        -- Lock-on beneficial in most cases
        optimalLockOn = math.random() > 0.3 and 1 or 0
        
        -- Normalize outputs
        local outputs = {
            optimalPred / 0.5,
            optimalRange / 100,
            optimalLockOn
        }
        
        table.insert(self.trainingData, {
            inputs = inputs,
            outputs = outputs
        })
    end
end

-- Backpropagation training
function NeuralNetwork:trainNetwork()
    if not self.trainingData then return end
    
    for epoch = 1, self.trainingIterations do
        local totalLoss = 0
        
        -- Train on all samples
        for _, sample in ipairs(self.trainingData) do
            -- Forward pass
            local predictions, cache = self:forward(sample.inputs)
            
            -- Calculate loss (Mean Squared Error)
            local loss = 0
            for i = 1, self.outputSize do
                local diff = predictions[i] - sample.outputs[i]
                loss = loss + diff * diff
            end
            loss = loss / self.outputSize
            totalLoss = totalLoss + loss
            
            -- Backpropagation
            -- Output layer gradients
            local deltaO = {}
            for k = 1, self.outputSize do
                local error = predictions[k] - sample.outputs[k]
                deltaO[k] = error * self:sigmoidDerivative(cache.zo[k])
            end
            
            -- Hidden layer 3 gradients
            local deltaH3 = {}
            for j = 1, self.hiddenSize3 do
                local error = 0
                for k = 1, self.outputSize do
                    error = error + deltaO[k] * self.weightsH3O[j][k]
                end
                deltaH3[j] = error * self:leakyReluDerivative(cache.z3[j])
            end
            
            -- Hidden layer 2 gradients
            local deltaH2 = {}
            for j = 1, self.hiddenSize2 do
                local error = 0
                for k = 1, self.hiddenSize3 do
                    error = error + deltaH3[k] * self.weightsH2H3[j][k]
                end
                deltaH2[j] = error * self:tanhDerivative(cache.z2[j])
            end
            
            -- Hidden layer 1 gradients
            local deltaH1 = {}
            for j = 1, self.hiddenSize1 do
                local error = 0
                for k = 1, self.hiddenSize2 do
                    error = error + deltaH2[k] * self.weightsH1H2[j][k]
                end
                deltaH1[j] = error * self:leakyReluDerivative(cache.z1[j])
            end
            
            -- Update weights and biases
            -- Hidden3 to Output
            for j = 1, self.hiddenSize3 do
                for k = 1, self.outputSize do
                    self.weightsH3O[j][k] = self.weightsH3O[j][k] - self.learningRate * deltaO[k] * cache.h3[j]
                end
            end
            for k = 1, self.outputSize do
                self.biasO[k] = self.biasO[k] - self.learningRate * deltaO[k]
            end
            
            -- Hidden2 to Hidden3
            for j = 1, self.hiddenSize2 do
                for k = 1, self.hiddenSize3 do
                    self.weightsH2H3[j][k] = self.weightsH2H3[j][k] - self.learningRate * deltaH3[k] * cache.h2[j]
                end
            end
            for k = 1, self.hiddenSize3 do
                self.biasH3[k] = self.biasH3[k] - self.learningRate * deltaH3[k]
            end
            
            -- Hidden1 to Hidden2
            for j = 1, self.hiddenSize1 do
                for k = 1, self.hiddenSize2 do
                    self.weightsH1H2[j][k] = self.weightsH1H2[j][k] - self.learningRate * deltaH2[k] * cache.h1[j]
                end
            end
            for k = 1, self.hiddenSize2 do
                self.biasH2[k] = self.biasH2[k] - self.learningRate * deltaH2[k]
            end
            
            -- Input to Hidden1
            for i = 1, self.inputSize do
                for j = 1, self.hiddenSize1 do
                    self.weightsIH1[i][j] = self.weightsIH1[i][j] - self.learningRate * deltaH1[j] * sample.inputs[i]
                end
            end
            for j = 1, self.hiddenSize1 do
                self.biasH1[j] = self.biasH1[j] - self.learningRate * deltaH1[j]
            end
        end
        
        self.trainingLoss = totalLoss / #self.trainingData
        self.epoch = epoch
    end
end

-- Collect performance samples
function NeuralNetwork:collectSample()
    if not State.localHRP or not State.targetHRP then return end
    
    local sample = {
        inputs = {
            State.predictionFactor / 0.5,  -- Normalized to 0-1
            State.rangeDistance / 100,     -- Normalized to 0-1
            State.lockOn and 1 or 0,       -- Boolean to 0 or 1
            math.min(State.currentFPS / 60, 1)  -- Normalized FPS
        },
        score = self:calculateScore()
    }
    
    table.insert(self.samples, sample)
    if #self.samples > self.maxSamples then
        table.remove(self.samples, 1)  -- Remove oldest sample
    end
    
    return sample.score
end

-- Optimize settings using neural network
function NeuralNetwork:optimize()
    if #self.samples < 5 then
        return false, "Need more samples (collecting data...)"
    end
    
    -- Find best performing sample
    local bestSample = self.samples[1]
    for _, sample in ipairs(self.samples) do
        if sample.score > bestSample.score then
            bestSample = sample
        end
    end
    
    -- Use network to predict optimal settings based on best sample
    local outputs = self:forward(bestSample.inputs)
    
    -- Apply optimized settings (denormalize)
    local newPrediction = outputs[1] * 0.5
    local newRange = outputs[2] * 100
    local newLockOn = outputs[3] > 0.5
    
    -- ENHANCED BOUNDS CHECKING: Prevent prediction values near 0.5
    -- Values between 0.4-0.5 cause teleporting and erratic movement
    if newPrediction >= 0.40 then
        -- Cap at safe maximum to prevent teleporting
        newPrediction = 0.35  -- Safe upper limit
    end
    
    -- Additional safety: If prediction is too high for current conditions, reduce it
    if newPrediction >= 0.30 then
        -- Check if FPS is high enough to support this prediction
        local currentFPS = bestSample.inputs[4] * 60  -- Denormalize FPS
        if currentFPS < 45 then
            -- Low FPS, reduce prediction to prevent jitter
            newPrediction = math.min(newPrediction, 0.20)
        end
    end
    
    -- Clamp values to safe ranges
    newPrediction = math.max(0, math.min(0.35, newPrediction))  -- Max 0.35 instead of 0.5
    newRange = math.max(10, math.min(100, newRange))
    
    return true, {
        prediction = newPrediction,
        range = newRange,
        lockOn = newLockOn,
        score = bestSample.score
    }
end

-- Start optimization process
function NeuralNetwork:startOptimization()
    if self.running then return end
    
    self.running = true
    self.samples = {}
    
    Rayfield:Notify({
        Title = "Neural Network Optimizer",
        Content = "Starting optimization... Collecting performance data",
        Duration = 3,
        Image = nil
    })
    
    -- Collect samples every 2 seconds
    task.spawn(function()
        while self.running do
            self:collectSample()
            task.wait(2)
        end
    end)
end

-- Stop optimization process
function NeuralNetwork:stopOptimization()
    self.running = false
end

-- Initialize the neural network
NeuralNetwork:init()

-- SETTINGS TAB
local SettingsSection = SettingsTab:CreateSection("Performance Settings")

local PerformanceLabel = SettingsTab:CreateLabel("All features optimized for RenderStepped")

-- Neural Network Optimization Section
local NNSection = SettingsTab:CreateSection("🧠 Enhanced Deep Neural Network")

local NNLabel = SettingsTab:CreateLabel("AI-powered optimization with 4-layer deep network (4→8→8→4→3)")

local NNArchLabel = SettingsTab:CreateLabel("Features: LeakyReLU/Tanh activations, He/Xavier init, Backpropagation")

local NNOptimizeToggle = SettingsTab:CreateToggle({
    Name = "🤖 Enable AI Optimization",
    CurrentValue = false,
    Flag = "NNOptimizeToggle",
    Callback = function(value)
        if value then
            NeuralNetwork:startOptimization()
        else
            NeuralNetwork:stopOptimization()
        end
    end
})

local NNApplyButton = SettingsTab:CreateButton({
    Name = "✨ Apply Deep Learning Optimized Settings",
    Callback = function()
        local success, result = NeuralNetwork:optimize()
        
        if success then
            -- Apply the optimized settings
            State.predictionFactor = result.prediction
            State.rangeDistance = result.range
            
            -- Update UI sliders
            if State.rangePart then
                State.rangePart.Size = Vector3.new(result.range * 2, 0.5, result.range * 2)
            end
            
            Rayfield:Notify({
                Title = "Deep Learning Applied ✓",
                Content = string.format(
                    "Prediction: %.3f | Range: %.0f | Score: %.1f | Epoch: %d",
                    result.prediction,
                    result.range,
                    result.score,
                    NeuralNetwork.epoch
                ),
                Duration = 5,
                Image = nil
            })
        else
            Rayfield:Notify({
                Title = "Optimization Not Ready",
                Content = result,
                Duration = 3,
                Image = nil
            })
        end
    end
})

local NNStatusLabel = SettingsTab:CreateLabel("Status: Pre-trained on 100 samples | Training Loss: " .. string.format("%.4f", NeuralNetwork.trainingLoss))

-- Update status label periodically
task.spawn(function()
    while true do
        task.wait(2)
        if NeuralNetwork.running then
            local sampleCount = #NeuralNetwork.samples
            local currentScore = NeuralNetwork:calculateScore()
            NNStatusLabel:Set(string.format(
                "Collecting data (%d/%d) | Score: %.1f | Loss: %.4f | Epochs: %d",
                sampleCount,
                NeuralNetwork.maxSamples,
                currentScore,
                NeuralNetwork.trainingLoss,
                NeuralNetwork.epoch
            ))
        else
            NNStatusLabel:Set(string.format(
                "Pre-trained on 100 samples | Loss: %.4f | Ready for collection",
                NeuralNetwork.trainingLoss
            ))
        end
    end
end)

local StopAllButton = SettingsTab:CreateButton({
    Name = "🛑 Stop All Features",
    Callback = function()
        stopAllFeatures()
        NeuralNetwork:stopOptimization()
        Rayfield:Notify({
            Title = "Stopped",
            Content = "All features disabled",
            Duration = 2,
            Image = nil
        })
    end
})

