    Name = "Prediction Factor",
    Range = {0, 0.5},
    Increment = 0.01,
    CurrentValue = 0.15,
    Flag = "PredictionSlider",
    Callback = function(value)
        -- BOUNDS WARNING: Notify user if prediction is dangerously high
        if value >= 0.40 then
            Rayfield:Notify({
                Title = "⚠️ Warning: High Prediction",
                Content = "Values ≥0.4 may cause teleporting! Recommend ≤0.35",
                Duration = 4,
                Image = nil
            })
            -- Automatically cap at safe value
            value = 0.35
        elseif value >= 0.35 then
            Rayfield:Notify({
                Title = "⚠️ Caution: High Prediction",
                Content = "Approaching unstable range. Monitor for teleporting.",
                Duration = 3,
                Image = nil
            })
        end
        
        State.predictionFactor = value
    end
})

