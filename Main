-- ═══════════════════════════════════════════
-- STATUS UPDATER (V10: Decoupled from Render Loop)
-- ═══════════════════════════════════════════
task.spawn(function()
    while true do
        local start = time()
        task.wait(0.5)
        local elapsed = time() - start
        if elapsed > 0 then fpsVal = fpsFrames / elapsed end
        fpsFrames = 0
        
        local mode = doMimic and "⚡ MIMIC" or "— IDLE"
        local dist = targetDistSq > 0 and floor(sqrt(targetDistSq)) or 0
        local spd = floor(speedVal * velMult)
        statusLabel:Set(mode .. " | " .. floor(fpsVal) .. " fps | " .. spd .. " s/s | " .. dist .. "s")
        targetLabel:Set("Target: " .. targetName .. (dist > 0 and " (" .. dist .. "s)" or ""))
    end
end)

-- ═══════════════════════════════════════════
-- RESPAWN HANDLER
-- ═══════════════════════════════════════════
player.CharacterAdded:Connect(function(char)
    task.wait(1)
    stopAll()
    initLocalChar(char)
end)

-- ═══════════════════════════════════════════
-- V10: PANIC KEY (RightShift)
-- ═══════════════════════════════════════════
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        stopAll()
        Rayfield:Notify({Title = "⚠️ PANIC", Content = "All features halted", Duration = 2})
    end
end)

-- ═══════════════════════════════════════════
-- INIT
-- ═══════════════════════════════════════════
if player.Character then initLocalChar(player.Character) end

Rayfield:Notify({
    Title = "⚡ TSB MIMIC ULTRA V10",
    Content = "Phantom build — Dash-Snap + 15ms Movesync + O(1) NoClip",
    Duration = 4,
    Image = 4483362458
})

