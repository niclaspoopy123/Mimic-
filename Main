-- OPTIMIZED TSB MIMIC SCRIPT - MAXIMUM PERFORMANCE
-- Features: Anti-stun, Anti-ragdoll, Anti-launch, Lock-on, Camera Lock, Range Visualizer, Moveset Mimic
-- Optimized for minimal latency with cached values and efficient RenderStepped loops

-- Services - Cached once
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera

-- Player references - Cached
local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Load Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Create optimized window
local Window = Rayfield:CreateWindow({
    Name = "⚡ TSB OPTIMIZED MIMIC HUB",
    LoadingTitle = "Loading Optimized Script...",
    LoadingSubtitle = "by Optimized Performance Team",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = nil,
        FileName = "TSBMimicOptimized"
    },
    Discord = {
        Enabled = false
    },
    KeySystem = false
})

-- Performance state - All cached for speed
local State = {
    -- Target data
    targetChar = nil,
    targetHRP = nil,
    targetHumanoid = nil,
    targetLastPos = Vector3.zero,
    targetVelocity = Vector3.zero,
    targetAcceleration = Vector3.zero,
    
    -- Local data
    localChar = nil,
    localHRP = nil,
    localHumanoid = nil,
    
    -- Connections
    mimicConn = nil,
    antiStunConn = nil,
    antiRagdollConn = nil,
    antiLaunchConn = nil,
    lockOnConn = nil,
    cameraLockConn = nil,
    movesetConn = nil,
    rangeUpdateConn = nil,
    
    -- Feature toggles
    mimicEnabled = false,
    antiStun = false,
    antiRagdoll = false,
    antiLaunch = false,
    lockOn = false,
    cameraLock = false,
    movesetMimic = false,
    rangeViz = false,
    prediction = true,
    
    -- Performance settings
    predictionFactor = 0.15,
    updateRate = 0, -- RenderStepped every frame
    rangeDistance = 50,
    currentFPS = 60, -- Cached FPS value
    
    -- Moveset data cache
    movesetData = {},
    lastMoveTime = 0,
    moveCooldown = 0.1,
    
    -- Range visualizer
    rangePart = nil
}

-- Optimized utility functions (minimal overhead)
local function safeDisconnect(conn)
    if conn then pcall(function() conn:Disconnect() end) end
end

local function updateLocalCache()
    State.localChar = player.Character
    if State.localChar then
        State.localHRP = State.localChar:FindFirstChild("HumanoidRootPart")
        State.localHumanoid = State.localChar:FindFirstChild("Humanoid")
    end
end

local function updateTargetCache()
    if State.targetChar then
        State.targetHRP = State.targetChar:FindFirstChild("HumanoidRootPart")
        State.targetHumanoid = State.targetChar:FindFirstChild("Humanoid")
    end
end

-- ANTI-STUN (Prevents stun states)
local function setupAntiStun()
    if State.antiStunConn then return end
    
    State.antiStunConn = RunService.Heartbeat:Connect(function()
        if not State.localHumanoid then updateLocalCache() return end
        
        -- Fast state check and reset
        local state = State.localHumanoid:GetState()
        if state == Enum.HumanoidStateType.Strafing or 
           state == Enum.HumanoidStateType.FallingDown or
           state == Enum.HumanoidStateType.Ragdoll then
            State.localHumanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

-- ANTI-RAGDOLL (Prevents ragdoll physics)
local function setupAntiRagdoll()
    if State.antiRagdollConn then return end
    
    State.antiRagdollConn = RunService.Heartbeat:Connect(function()
        if not State.localHumanoid then updateLocalCache() return end
        
        -- Keep platform stand disabled
        if State.localHumanoid.PlatformStand and not State.mimicEnabled then
            State.localHumanoid.PlatformStand = false
        end
        
        -- Reset sit state
        if State.localHumanoid.Sit then
            State.localHumanoid.Sit = false
        end
    end)
end

-- ANTI-LAUNCH (Prevents being launched/knocked back)
local function setupAntiLaunch()
    if State.antiLaunchConn then return end
    
    State.antiLaunchConn = RunService.Heartbeat:Connect(function()
        if not State.localHRP then updateLocalCache() return end
        
        -- Clamp velocity to prevent launches
        local vel = State.localHRP.AssemblyLinearVelocity
        if vel.Magnitude > 100 and not State.mimicEnabled then
            State.localHRP.AssemblyLinearVelocity = vel.Unit * 100
        end
        
        -- Keep grounded
        if State.localHRP.AssemblyLinearVelocity.Y > 50 and not State.mimicEnabled then
            State.localHRP.AssemblyLinearVelocity = Vector3.new(
                State.localHRP.AssemblyLinearVelocity.X,
                math.min(State.localHRP.AssemblyLinearVelocity.Y, 50),
                State.localHRP.AssemblyLinearVelocity.Z
            )
        end
    end)
end

-- OPTIMIZED PREDICTION (Cached calculations)
local function getPredictedPosition()
    if not State.prediction or not State.targetHRP then 
        return State.targetHRP and State.targetHRP.Position or Vector3.zero
    end
    
    -- Use cached velocity and acceleration
    local currentVel = State.targetHRP.AssemblyLinearVelocity
    local dt = State.predictionFactor
    
    -- Update acceleration (cached from last frame)
    State.targetAcceleration = (currentVel - State.targetVelocity) / 0.016
    State.targetVelocity = currentVel
    
    -- Kinematic prediction: p = p0 + v*t + 0.5*a*t^2
    return State.targetHRP.Position + 
           currentVel * dt + 
           State.targetAcceleration * (0.5 * dt * dt)
end

-- LOCK-ON SYSTEM (Smooth target tracking)
local function setupLockOn()
    if State.lockOnConn then return end
    
    State.lockOnConn = RunService.RenderStepped:Connect(function()
        if not State.targetHRP or not State.localHRP then return end
        
        -- Calculate direction to target
        local direction = (State.targetHRP.Position - State.localHRP.Position).Unit
        local lookCFrame = CFrame.lookAt(State.localHRP.Position, State.targetHRP.Position)
        
        -- Smooth rotation lock-on
        State.localHRP.CFrame = CFrame.new(State.localHRP.Position) * 
                                 (State.localHRP.CFrame.Rotation:Lerp(lookCFrame.Rotation, 0.3))
    end)
end

-- CAMERA LOCK-ON (Camera follows target)
local function setupCameraLock()
    if State.cameraLockConn then return end
    
    State.cameraLockConn = RunService.RenderStepped:Connect(function()
        if not State.targetHRP then return end
        
        -- Lock camera to target
        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, State.targetHRP.Position)
    end)
end

local function disableCameraLock()
    Camera.CameraType = Enum.CameraType.Custom
end

-- RANGE VISUALIZER (Shows attack range)
local function createRangeVisualizer()
    if State.rangePart then State.rangePart:Destroy() end
    
    State.rangePart = Instance.new("Part")
    State.rangePart.Name = "RangeVisualizer"
    State.rangePart.Size = Vector3.new(State.rangeDistance * 2, 0.5, State.rangeDistance * 2)
    State.rangePart.Transparency = 0.7
    State.rangePart.CanCollide = false
    State.rangePart.Anchored = true
    State.rangePart.Color = Color3.fromRGB(255, 100, 100)
    State.rangePart.Material = Enum.Material.Neon
    State.rangePart.Parent = Workspace
    
    -- Add cylinder mesh for better visuals
    local mesh = Instance.new("CylinderMesh")
    mesh.Parent = State.rangePart
end

local function updateRangeVisualizer()
    if State.rangeUpdateConn then return end
    
    State.rangeUpdateConn = RunService.Heartbeat:Connect(function()
        if not State.rangeViz or not State.localHRP or not State.rangePart then return end
        
        State.rangePart.Position = State.localHRP.Position
        
        -- Color based on target distance
        if State.targetHRP then
            local distance = (State.targetHRP.Position - State.localHRP.Position).Magnitude
            if distance <= State.rangeDistance then
                State.rangePart.Color = Color3.fromRGB(100, 255, 100) -- Green in range
            else
                State.rangePart.Color = Color3.fromRGB(255, 100, 100) -- Red out of range
            end
        end
    end)
end

-- MOVESET MIMIC (Replicates target's moves)
local function setupMovesetMimic()
    if State.movesetConn then return end
    
    State.movesetConn = RunService.Heartbeat:Connect(function()
        if not State.targetChar or not State.localChar then return end
        
        local currentTime = tick()
        if currentTime - State.lastMoveTime < State.moveCooldown then return end
        
        -- Detect and mimic combat animations
        local targetAnimator = State.targetChar:FindFirstChild("Humanoid")
        if targetAnimator then
            local targetTracks = targetAnimator:GetPlayingAnimationTracks()
            local localAnimator = State.localHumanoid
            
            if localAnimator then
                for _, track in ipairs(targetTracks) do
                    -- Check if it's a combat animation (common TSB move patterns)
                    local animName = track.Animation.AnimationId
                    if animName:find("punch") or animName:find("kick") or 
                       animName:find("attack") or animName:find("skill") then
                        
                        -- Try to play same animation on local character
                        if not State.movesetData[animName] then
                            State.movesetData[animName] = track.Animation
                        end
                        
                        -- Load and play animation
                        pcall(function()
                            local anim = localAnimator:LoadAnimation(State.movesetData[animName])
                            anim:Play()
                        end)
                        
                        State.lastMoveTime = currentTime
                        break
                    end
                end
            end
        end
    end)
end

-- CORE MIMIC FUNCTION (Maximum optimization)
local function mimicCore()
    if not State.targetHRP or not State.localHRP then 
        updateTargetCache()
        updateLocalCache()
        return 
    end
    
    -- Get predicted position (using cached calculations)
    local predictedPos = getPredictedPosition()
    
    -- Apply position and rotation in one operation
    State.localHRP.CFrame = CFrame.new(predictedPos) * State.targetHRP.CFrame.Rotation
    
    -- Sync velocity for smooth physics
    State.localHRP.AssemblyLinearVelocity = State.targetHRP.AssemblyLinearVelocity
    
    -- Sync angular velocity for rotation matching
    State.localHRP.AssemblyAngularVelocity = State.targetHRP.AssemblyAngularVelocity
    
    -- Jump state synchronization
    if State.targetHumanoid and State.localHumanoid then
        local targetState = State.targetHumanoid:GetState()
        if targetState == Enum.HumanoidStateType.Jumping or 
           targetState == Enum.HumanoidStateType.Freefall then
            local localState = State.localHumanoid:GetState()
            if localState ~= Enum.HumanoidStateType.Jumping and 
               localState ~= Enum.HumanoidStateType.Freefall then
                State.localHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end

-- START MIMIC (Optimized initialization)
local function startMimic(targetChar)
    if State.mimicConn then safeDisconnect(State.mimicConn) end
    
    State.targetChar = targetChar
    updateTargetCache()
    updateLocalCache()
    
    if not State.targetHRP or not State.localHRP then return end
    
    -- Enable platform stand for smooth mimicking
    if State.localHumanoid then
        State.localHumanoid.PlatformStand = true
    end
    
    State.mimicEnabled = true
    
    -- Use RenderStepped for fastest possible updates
    State.mimicConn = RunService.RenderStepped:Connect(mimicCore)
end

-- STOP ALL FUNCTIONS
local function stopAllFeatures()
    -- Disconnect all connections
    safeDisconnect(State.mimicConn)
    safeDisconnect(State.antiStunConn)
    safeDisconnect(State.antiRagdollConn)
    safeDisconnect(State.antiLaunchConn)
    safeDisconnect(State.lockOnConn)
    safeDisconnect(State.cameraLockConn)
    safeDisconnect(State.movesetConn)
    safeDisconnect(State.rangeUpdateConn)
    
    -- Reset state
    State.mimicConn = nil
    State.antiStunConn = nil
    State.antiRagdollConn = nil
    State.antiLaunchConn = nil
    State.lockOnConn = nil
    State.cameraLockConn = nil
    State.movesetConn = nil
    State.rangeUpdateConn = nil
    State.mimicEnabled = false
    
    -- Clean up visualizer
    if State.rangePart then
        State.rangePart:Destroy()
        State.rangePart = nil
    end
    
    -- Reset character
    updateLocalCache()
    if State.localHumanoid then
        State.localHumanoid.PlatformStand = false
    end
    
    disableCameraLock()
end

