    Name = "⚡ Start Mimic (PHANTOM V10)",
    CurrentValue = false,
    Flag = "Mimic",
    Callback = function(v)
        if syncingUI then return end
        if v and not tChar then
            Rayfield:Notify({ Title = "No Target", Content = "Select a target first!", Duration = 2, Image = 4483362458 })
            return
        end
        setMimicActive(v)
        if v then
            Rayfield:Notify({ Title = "Mimic Active", Content = "Frame-by-frame sync + Dash-Snap + Phantom NoClip", Duration = 2, Image = 4483362458 })
        end
    end
})

