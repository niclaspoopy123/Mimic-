    Name = "Range Distance",
    Range = {10, 100},
    Increment = 5,
    CurrentValue = 50,
    Flag = "RangeSlider",
    Callback = function(value)
        State.rangeDistance = value
        if State.rangePart then
            State.rangePart.Size = Vector3.new(value * 2, 0.5, value * 2)
        end
    end
})

